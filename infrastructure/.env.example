# -------------------------------------------------------------------
# Project Sentinel — Infrastructure Node Environment Variables
# -------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -------------------------------------------------------------------
# Tailscale Mesh Binding
# -------------------------------------------------------------------
# Set this to your Infrastructure Node's Tailscale IP (100.x.y.z)
# to restrict database ports exclusively to the mesh network.
# Leave blank or set to 127.0.0.1 for local-only development.
TAILSCALE_BIND_IP=127.0.0.1

# -------------------------------------------------------------------
# ChromaDB Auth (Optional — recommended for multi-user mesh setups)
# -------------------------------------------------------------------
CHROMA_AUTH_PROVIDER=
CHROMA_AUTH_CREDENTIALS_FILE=

# -------------------------------------------------------------------
# MCP Server Ports
# -------------------------------------------------------------------
FS_MANAGER_PORT=8010
GIT_SYNC_PORT=8012

# -------------------------------------------------------------------
# Inference Node Connection (set on the Infrastructure Node)
# -------------------------------------------------------------------
# The Tailscale IP of the Inference Node (MacBook M3).
# Used by the git-sync MCP to push session notifications.
INFERENCE_NODE_IP=100.x.y.z
INFERENCE_NODE_CALLBACK_PORT=9000

# -------------------------------------------------------------------
# LLM API (set on the Inference Node only — not here)
# -------------------------------------------------------------------
# OPENAI_API_KEY or GEMINI_API_KEY are managed on the Inference Node.
# Do not store API keys on the Infrastructure Node.
# -------------------------------------------------------------------
# Per-world isolation + access layer (ADR 0002 / 0003)
# -------------------------------------------------------------------
# All OFF by default — local/tailnet dev runs on the single shared tree,
# anonymous + unthrottled. The public cutover arms these; verify with
# `just cutover-check`. See docs/WORKSPACE.md § "Per-world isolation cutover".
#
# Per-world isolation: blank = shared tree. Set to the worlds root dir to route
# each world to its own repo. MUST match across backend, fs-manager, git-sync.
SENTINEL_WORLDS_ROOT=
# Per-world session tokens: blank = anonymous; set a strong secret to enforce.
SENTINEL_SESSION_TOKEN_SECRET=
# Rate limits (0 = disabled): per-IP world creation / per-world turns / global
# daily LLM-call ceiling.
SENTINEL_RL_SESSION_CREATE_PER_HOUR=0
SENTINEL_RL_STREAM_PER_MINUTE=0
SENTINEL_LLM_DAILY_CEILING=0
# Do NOT set SENTINEL_ALLOW_PUBLIC_BIND (MCP servers stay loopback-only).
SENTINEL_DEBUG=false
