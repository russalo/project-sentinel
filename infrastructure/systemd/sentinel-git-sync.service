# Sentinel git-sync MCP server (ADR 0003 Slice C). TEMPLATE.
# Install on origin-core (Linux):
#   1. Replace <REPO_ROOT> (e.g. /srv/projects/project-sentinel) and <USER>.
#   2. sudo cp this to /etc/systemd/system/sentinel-git-sync.service
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now sentinel-git-sync
# Linux-only; for macOS/Windows dev use `just git-sync` / `just start`.
[Unit]
Description=Sentinel git-sync MCP server (per-turn git commit of world state)
After=network.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<REPO_ROOT>
# SENTINEL_WORLDS_ROOT etc. — must match the backend and fs-manager.
EnvironmentFile=<REPO_ROOT>/infrastructure/.env
# No --host → defaults to 127.0.0.1 (the A2 bind guard refuses all-interfaces).
ExecStart=<REPO_ROOT>/.venv/bin/python mcp-servers/git-sync/server.py --port 8012
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
