# Sentinel STAGING env overrides (RFC-0016). TEMPLATE — copy to
# infrastructure/.env.staging (gitignored) and fill <STAGING_WORLDS_ROOT>.
#
# The staging systemd units load this AFTER infrastructure/.env, and per
# systemd.exec a later EnvironmentFile overrides an earlier one — so these values
# win over the prod .env WITHOUT relying on Environment= (which EnvironmentFile
# overrides, the trap this file exists to avoid). The shared LLM key stays in
# .env and is inherited (not overridden here). If this file is missing the
# staging units fail to start — deliberately, so they never fall back to prod.

# The staging world store — MUST differ from the prod SENTINEL_WORLDS_ROOT.
SENTINEL_WORLDS_ROOT=<STAGING_WORLDS_ROOT>

# The staging backend talks to the STAGING MCP servers (alt ports).
FS_MANAGER_URL=http://127.0.0.1:8110
GIT_SYNC_URL=http://127.0.0.1:8112

# Session-token gate OFF on staging (tailnet membership is the access control on
# sentinel-staging.dev — worlds open without a token). Empty = disabled.
SENTINEL_SESSION_TOKEN_SECRET=

# Staging's own small daily LLM ceiling so staging play can't drain prod's budget.
SENTINEL_LLM_DAILY_CEILING=200
