# infrastructure/.env
# Auto-generated by `just env` (chezmoi template).
# Source: .chezmoi/infrastructure/private_dot_env.tmpl
#
# DO NOT edit this file directly — edit the template and re-run `just env`.
# The rendered file is mode 0600 (the source is `private_`): on armed hosts it
# carries SENTINEL_SESSION_TOKEN_SECRET.
#
# HOST-GATED. A host is "armed" iff it has a ~/.sentinel-armed marker file
# (origin-core — the live closed alpha). Armed hosts get the access-layer knobs,
# the LiteLLM->Gemini routing, and the age-decrypted session-token secret. Every
# other host — dev laptops, fresh clones, CI — gets safe dormant defaults
# (shared tree, anonymous, unthrottled, Groq routing, blank secret). The marker
# is host-local and uncommitted, so a clone never self-arms. Arm a new host
# (e.g. prod-core) with:  touch ~/.sentinel-armed
{{- $armed := stat (joinPath .chezmoi.homeDir ".sentinel-armed") -}}
{{- $haveAgeKey := stat (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") -}}

# --- Tailscale Mesh Binding ---------------------------------------------------
# 127.0.0.1 = local-only dev (no Tailscale required).
# For multi-node deployments, set this to your Infrastructure Node's
# Tailscale IP (100.x.y.z) to restrict DB ports to the mesh network.
TAILSCALE_BIND_IP=127.0.0.1

# --- Docker Host (OS-specific) ------------------------------------------------
{{ if eq .chezmoi.os "darwin" -}}
# macOS - Docker Desktop newer versions use a user-space socket.
# Uncomment the line below if `docker compose up` fails with a socket error:
# DOCKER_HOST=unix://${HOME}/.docker/run/docker.sock
{{ else if eq .chezmoi.os "windows" -}}
# Windows - Docker Engine exposes a named pipe over WSL2.
# Uncomment the line below if containers fail to start:
# DOCKER_HOST=npipe:////./pipe/docker_engine
{{ else -}}
# Linux - standard socket path, no override needed.
{{ end -}}

# --- ChromaDB Auth (disabled for local dev) -----------------------------------
CHROMA_AUTH_PROVIDER=
CHROMA_AUTH_CREDENTIALS_FILE=

# --- MCP Server Ports ---------------------------------------------------------
FS_MANAGER_PORT=8010
GIT_SYNC_PORT=8012

# --- Inference Node Connection ------------------------------------------------
INFERENCE_NODE_IP=127.0.0.1
INFERENCE_NODE_CALLBACK_PORT=9000

# --- LLM / DM AI (HOST-GATED) -------------------------------------------------
# Armed hosts route through the tailnet LiteLLM proxy (-> Google Gemini
# gemini-2.5-flash); the real cloud key lives in LiteLLM's own config.yaml, NOT
# here (the armed OPENAI_API_KEY below is a non-secret LiteLLM passthrough
# string). Dev hosts default to Groq - set your own gsk_ key + base_url.
{{ if $armed -}}
OPENAI_BASE_URL=http://100.89.175.30:4000/v1
OPENAI_API_KEY=sk-litellm-passthrough
DM_MODEL=dm-sentinel
{{ else -}}
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your-groq-key-here
DM_MODEL=llama-3.3-70b-versatile
{{ end -}}

# --- Python Binary (OS-specific hint) -----------------------------------------
{{ if eq .chezmoi.os "windows" -}}
PYTHON_BIN=python
{{ else -}}
PYTHON_BIN=python3
{{ end -}}

# --- Per-world isolation + access layer (ADR 0002 / 0003) - HOST-GATED --------
# Armed (origin-core, closed alpha) vs dormant dev defaults. See the header note
# on ~/.sentinel-armed. The MCP servers + backend must agree on WORLDS_ROOT
# (`just cutover-check` verifies); arming is driven by the marker now, not a
# hand-edited .env.
{{ if $armed -}}
SENTINEL_WORLDS_ROOT={{ .chezmoi.homeDir }}/sentinel-worlds
{{ else -}}
SENTINEL_WORLDS_ROOT=
{{ end -}}
# Per-world session-token secret. On an armed host WITH the shared age key it is
# decrypted from the committed ciphertext (.chezmoi/.chezmoitemplates/
# session_token_secret.age, encrypted to the mesh recipient). UNARMED hosts (dev
# / CI / fresh clone, no marker) render blank (anonymous) so `just env` never
# hard-fails there. But an ARMED host MISSING the key FAILS LOUD rather than
# rendering blank: a blank secret = token enforcement OFF, so silently degrading
# the live alpha to anonymous on a key-path mistake is the wrong failure mode —
# stop the render instead (gemini-high / codex-P1, PR #156).
SENTINEL_SESSION_TOKEN_SECRET={{ if $armed }}{{ if $haveAgeKey }}{{ includeTemplate "session_token_secret.age" | decrypt | trim }}{{ else }}{{ fail "armed host (~/.sentinel-armed present) is missing the age key at ~/.config/chezmoi/key.txt — refusing to render a blank SENTINEL_SESSION_TOKEN_SECRET, which would silently disable token enforcement on the live alpha" }}{{ end }}{{ end }}
# Rate limits (0 = disabled): per-IP world creation / per-world turns / global
# daily LLM-call ceiling. Concurrency: max in-flight /api/stream (503 at cap).
{{ if $armed -}}
SENTINEL_RL_SESSION_CREATE_PER_HOUR=20
SENTINEL_RL_STREAM_PER_MINUTE=30
SENTINEL_LLM_DAILY_CEILING=10000
SENTINEL_MAX_CONCURRENT_STREAMS=10
{{ else -}}
SENTINEL_RL_SESSION_CREATE_PER_HOUR=0
SENTINEL_RL_STREAM_PER_MINUTE=0
SENTINEL_LLM_DAILY_CEILING=0
SENTINEL_MAX_CONCURRENT_STREAMS=0
{{ end -}}
# Trusted reverse-proxy hops. 0 = no proxy (rate-limit keys on the socket peer,
# ignores client-spoofable X-Forwarded-For). Behind the Caddy edge set 1 so the
# limiter keys on the hop Caddy appends (the real client).
{{ if $armed -}}
SENTINEL_TRUSTED_PROXY_HOPS=1
{{ else -}}
SENTINEL_TRUSTED_PROXY_HOPS=0
{{ end -}}
# Do NOT set SENTINEL_ALLOW_PUBLIC_BIND - the MCP write layer must stay
# loopback-only. The Caddy invite hash ($SENTINEL_INVITE_HASH) is Caddy-side
# (its unit's EnvironmentFile), not read by the backend.

# --- In-product feedback (PR #116) - HOST-GATED -------------------------------
# Tester submissions are written under SENTINEL_FEEDBACK_ROOT (blank = feature
# off -> /api/feedback 503). Per-IP hourly submission limit (0 = disabled). The
# path is environment-specific, so it's armed-host-only, not a shared default.
{{ if $armed -}}
SENTINEL_FEEDBACK_ROOT=/srv/projects/project-sentinel/feedback
SENTINEL_RL_FEEDBACK_PER_HOUR=10
{{ else -}}
SENTINEL_FEEDBACK_ROOT=
SENTINEL_RL_FEEDBACK_PER_HOUR=0
{{ end -}}

# --- Debug --------------------------------------------------------------------
# OFF for safety. true = permissive CORS + verbose errors (dev only).
SENTINEL_DEBUG=false
