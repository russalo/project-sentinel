# infrastructure/.env
# Auto-generated by `just env` (chezmoi template).
# Source: .chezmoi/dot_infrastructure/dot_env.tmpl
#
# DO NOT edit this file directly.
# Edit the template and re-run `just env` to regenerate.

# ─── Tailscale Mesh Binding ───────────────────────────────────────────────────
# 127.0.0.1 = local-only dev (no Tailscale required).
# For multi-node deployments, set this to your Infrastructure Node's
# Tailscale IP (100.x.y.z) to restrict DB ports to the mesh network.
TAILSCALE_BIND_IP=127.0.0.1

# ─── Docker Host (OS-specific) ────────────────────────────────────────────────
{{ if eq .chezmoi.os "darwin" -}}
# macOS — Docker Desktop newer versions use a user-space socket.
# Uncomment the line below if `docker compose up` fails with a socket error:
# DOCKER_HOST=unix://${HOME}/.docker/run/docker.sock
{{ else if eq .chezmoi.os "windows" -}}
# Windows — Docker Engine exposes a named pipe over WSL2.
# Uncomment the line below if containers fail to start:
# DOCKER_HOST=npipe:////./pipe/docker_engine
{{ else -}}
# Linux — standard socket path, no override needed.
{{ end -}}

# ─── ChromaDB Auth (disabled for local dev) ───────────────────────────────────
# Enable for strict zero-trust Tailscale deployments only.
CHROMA_AUTH_PROVIDER=
CHROMA_AUTH_CREDENTIALS_FILE=

# ─── MCP Server Ports ─────────────────────────────────────────────────────────
FS_MANAGER_PORT=8010
GIT_SYNC_PORT=8012

# ─── Inference Node Connection ────────────────────────────────────────────────
# Set INFERENCE_NODE_IP to the Tailscale IP of your MacBook/Inference Node
# when running in split-node mode. 127.0.0.1 = single-machine dev.
INFERENCE_NODE_IP=127.0.0.1
INFERENCE_NODE_CALLBACK_PORT=9000

# ─── LLM / DM AI ─────────────────────────────────────────────────────────────
# OPENAI_BASE_URL points at any OpenAI-compatible endpoint. The default is Groq
# (fast, hosted; the current dev/recording provider). Swap it for your own
# routing as needed:
#
# Groq (hosted, OpenAI-compatible):   https://api.groq.com/openai/v1
# Real OpenAI directly:               (leave unset or blank)
# LiteLLM on the same machine:        http://localhost:4000/v1
# LiteLLM on Fedora via Tailscale:    http://<tailscale-ip>:4000/v1
# LiteLLM inside Docker (Linux host): http://172.17.0.1:4000/v1
#
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# The API key for the endpoint above. For Groq, set your gsk_... key here.
# For real OpenAI, use your sk-... key. LiteLLM accepts any non-empty string
# unless you configure auth.
OPENAI_API_KEY=gsk_your-groq-key-here
# Model name exactly as the endpoint expects it.
# Groq examples:  llama-3.3-70b-versatile  |  llama-3.1-8b-instant
# Other examples: gpt-4o-mini  |  claude-haiku-4-5-20251001  |  gemini/gemini-1.5-flash
DM_MODEL=llama-3.3-70b-versatile

# ─── Python Binary (OS-specific hint) ────────────────────────────────────────
# Scripts use python3; on Windows/WSL the binary may be `python`.
{{ if eq .chezmoi.os "windows" -}}
PYTHON_BIN=python
{{ else -}}
PYTHON_BIN=python3
{{ end -}}

# ─── Per-world isolation + access layer (ADR 0002 / 0003) ─────────────────────
# All OFF by default — local & tailnet dev runs on the single shared tree,
# anonymous + unthrottled. The public cutover (docs/WORKSPACE.md § "Per-world
# isolation cutover") arms these; verify readiness with `just cutover-check`.
#
# Per-world isolation: blank = single shared tree (default). Set to the worlds
# root dir to route each world to its own repo. MUST be the SAME value across
# the backend, fs-manager, and git-sync (the backend refuses to start otherwise;
# `just cutover-check` verifies they agree).
#
# Local-dev tip (no public exposure needed): setting this to a path OUTSIDE the
# repo makes each world its own git repo there, so gameplay's per-turn git-sync
# commits stop landing on the checked-out branch (no more `master` pollution).
# Set it, then restart all three via `just start` + `just dev-backend`. Example:
#   SENTINEL_WORLDS_ROOT=/home/you/sentinel-worlds
# See docs/WORKSPACE.md § "Local dev: keep gameplay out of the code repo".
SENTINEL_WORLDS_ROOT=
# Per-world session-token enforcement: blank = anonymous. Set a strong secret to
# require X-Sentinel-World-Token on world-scoped routes.
SENTINEL_SESSION_TOKEN_SECRET=
# Rate limits (0 = disabled): per-IP world creation / per-world turns / global
# daily LLM-call ceiling — a lenient closed-beta cost backstop.
SENTINEL_RL_SESSION_CREATE_PER_HOUR=0
SENTINEL_RL_STREAM_PER_MINUTE=0
SENTINEL_LLM_DAILY_CEILING=0
# Trusted reverse-proxy hops in front of the backend. 0 (default) = no proxy:
# the per-IP rate-limit key uses the socket peer and IGNORES X-Forwarded-For (a
# direct caller can spoof it). Behind the Caddy edge set 1 so the limiter keys on
# the hop Caddy appends (the real client), not a client-spoofable XFF entry.
SENTINEL_TRUSTED_PROXY_HOPS=0
# Do NOT set SENTINEL_ALLOW_PUBLIC_BIND — the MCP write layer must stay
# loopback-only. The Caddy invite hash ($SENTINEL_INVITE_HASH) is Caddy-side
# (its unit's EnvironmentFile), not read by the backend.

# ─── Debug ────────────────────────────────────────────────────────────────────
# OFF for safety. true = permissive CORS + verbose errors (dev only).
SENTINEL_DEBUG=false
