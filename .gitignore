# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Secrets — never commit environment files
infrastructure/.env

# Session-generated runtime game state — produced by fs-manager at play
# time and updated every turn. Tracked directories are preserved via
# .gitkeep files (per ADR 0001, data/ is the canonical store for world
# state, but the specific per-session JSON files and Markdown transcripts
# are runtime artifacts, not contributor-authored content). Core and
# community pre-seeded content is authored into data/lore/core/codex/
# and data/state/community/<pack>/ and is NOT ignored.
data/state/core/entities/*.json
data/state/core/locations/*.json
data/state/core/factions/*.json
data/state/core/items/*.json
data/state/core/sessions/*.json
data/state/core/world/*.json
data/lore/core/sessions/*.md
!data/**/.gitkeep
