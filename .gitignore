# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/

# Exported training datasets (build artifact — regenerate with `just export-training-data`)
datasets/

# Local per-world worlds root, if pointed inside the repo (the recommended
# default is ~/sentinel-worlds, outside the repo — see docs/WORKSPACE.md
# § "Local dev: keep gameplay out of the code repo"). Each world is its own
# git repo; never track them in the code repo.
/.worlds/

# Secrets — never commit environment files
infrastructure/.env
infrastructure/.env.staging

# Claude Code conversation transcripts — captured locally by the
# PreCompact hook in .claude/settings.json before compaction, so
# the full context of past sessions is preserved as JSONL files
# that never leave the machine.
chatlogs/

# Claude Code user-specific permission state — auto-managed by the
# CLI as users approve tool calls. Not shared across contributors.
.claude/settings.local.json

# Per-world write-lock files (ADR 0002 cross-process locking). Shared-mode lock
# dir under the repo root; per-world locks live under SENTINEL_WORLDS_ROOT
# (outside the code repo). Runtime artifacts, never committed.
.sentinel-locks/

# Internal review / red-team artifacts (triage docs, audit captures). Process
# notes kept out of the public repo — mirrors the sibling scanner project's
# gitignored scratch/review/. Never committed.
scratch/

# In-product feedback submissions (POST /api/feedback writes JSON files here).
# Same gameplay-pollution lesson as data/ — operational runtime data must not
# land in the code repo. Triaged into docs/ALPHA_FEEDBACK.md by hand;
# untriaged on-disk records stay here for the operator to read.
/feedback/

# Defensive: the old dot_infrastructure source mistargeted here (fixed in chore/env-chezmoi-reconcile).
.infrastructure/
