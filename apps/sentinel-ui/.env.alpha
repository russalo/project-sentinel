# Closed-alpha build config — public deployment at sentinel.russalo.com/alpha/.
# Committed (not secret). Loaded by `pnpm build --mode alpha` (alias:
# `pnpm build:alpha`). The default `pnpm build` continues to load
# .env.production for the existing tailnet dev-site flow.
#
# VITE_API_URL is a SAME-ORIGIN relative path: the SPA is served at
# sentinel.russalo.com/alpha/ and the API lives at
# sentinel.russalo.com/alpha/api/... — Caddy strips `/alpha` at the edge
# before reverse_proxy, so the backend still serves /api/... unchanged.
# Relative URL avoids the CORS preflight entirely.
VITE_API_URL=/alpha/api
